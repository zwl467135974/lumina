{
  "hooks": {
    "enabled": true,
    "timeoutMs": 5000,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Edit|Write|ApplyPatch",
          "hooks": [
            {
              "type": "process",
              "command": "python",
              "args": [
                "${ZCODE_PROJECT_DIR}/scripts/skill-reminder-hook.py"
              ],
              "timeoutMs": 5000
            }
          ]
        }
      ]
    }
  }
}
