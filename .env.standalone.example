# Lumina Standalone 环境变量模板
#
# 复制为 .env.standalone 并填入真实值，然后执行：
#   ./scripts/standalone.sh start
#
# 必填项只有 LLM_API_KEY，其它有默认值

# ============ LLM（必填） ============
# 智谱 GLM（推荐，便宜）
LLM_TYPE=glm
LLM_API_KEY=your-glm-key.bigmodel.cn
LLM_MODEL=glm-4-flash
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 或阿里 DashScope
# LLM_TYPE=dashscope
# LLM_API_KEY=your-dashscope-key
# LLM_MODEL=qwen-plus

# 或 OpenAI 兼容（DeepSeek/Kimi/豆包 等）
# LLM_TYPE=openai
# LLM_API_KEY=your-key
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1

# ============ MySQL（必填） ============
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/lumina_dev?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=123456

# ============ Redis（必填） ============
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=123456

# ============ JWT secret（必填，≥32 字符，生产务必改） ============
LUMINA_JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars-long

# ============ RAG 知识库（可选，默认关闭） ============
# 开启需要 Qdrant（端口 6333）+ Embedding API
# RAG_ENABLED=true
# RAG_STORE_TYPE=qdrant
# QDRANT_HOST=127.0.0.1:6333
# QDRANT_COLLECTION=lumina_knowledge
# 硅基流动 SiliconFlow（便宜）
# RAG_EMBEDDING_PROVIDER=openai
# RAG_EMBEDDING_API_KEY=your-siliconflow-key
# RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# RAG_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# RAG_EMBEDDING_DIMENSIONS=1024
# RAG_EMBEDDING_SEND_DIMENSIONS=false

# ============ 其它（可选，有默认） ============
# REFLECTIVE_MEMORY_ENABLED=false
# MCP_ENABLED=false
# OTEL_SAMPLING_PROBABILITY=0.0
