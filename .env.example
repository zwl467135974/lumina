# ============================================================
# Lumina 环境变量配置
# 复制本文件为 .env 后按需修改；切勿将真实密码提交到仓库
# docker-compose 会自动读取同目录下的 .env
# ============================================================

# ---------- 基础设施（docker-compose 内 MySQL/Redis/Nacos 使用）----------

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=lumina
MYSQL_USER=lumina
MYSQL_PASSWORD=change-me-app-password

# Redis
REDIS_PASSWORD=change-me-redis-password

# Nacos
NACOS_USERNAME=nacos
NACOS_PASSWORD=change-me-nacos-password
# Nacos 鉴权 Token，长度需 ≥32 字符
NACOS_AUTH_TOKEN=change-me-nacos-auth-token-at-least-32-chars-long

# ---------- 应用层（所有 Spring 服务通用）----------

# JWT 密钥：生产必须设置为足够长的随机字符串（≥32 字符）
LUMINA_JWT_SECRET=change-me-jwt-secret-at-least-32-chars-long

# ---------- 本地开发（不走 docker-compose、直接 IDE/命令行启动时）----------

# 本地 MySQL（application.yml 默认占位为 root/root123，按实际环境覆盖）
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=
# 本地 Redis（默认无密码）
SPRING_DATA_REDIS_PASSWORD=

# LLM（仅 Agent 服务，可选；不配置则走模拟模式）
LLM_API_KEY=
LLM_MODEL=qwen-max

# ---------- 监控（Prometheus + Grafana）----------
GRAFANA_PASSWORD=admin

# ---------- JVM ----------
GATEWAY_JAVA_OPTS=-Xms512m -Xmx512m
BUSINESS_BASE_JAVA_OPTS=-Xms512m -Xmx512m
AGENT_SERVICE_JAVA_OPTS=-Xms512m -Xmx512m
