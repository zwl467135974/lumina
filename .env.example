# ============================================================
# Lumina 环境变量配置
# 复制本文件为 .env 后按需修改；切勿将真实密码提交到仓库
# docker-compose 会自动读取同目录下的 .env
# ============================================================

# ---------- 基础设施（docker-compose 内 MySQL/Redis/Nacos 使用）----------

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=lumina
MYSQL_USER=lumina
MYSQL_PASSWORD=change-me-app-password

# Redis
REDIS_PASSWORD=change-me-redis-password

# Nacos
NACOS_USERNAME=nacos
NACOS_PASSWORD=change-me-nacos-password
# Nacos 鉴权 Token，长度需 ≥32 字符
NACOS_AUTH_TOKEN=change-me-nacos-auth-token-at-least-32-chars-long

# ---------- 应用层（所有 Spring 服务通用）----------

# JWT 密钥：生产必须设置为足够长的随机字符串（≥32 字符）
LUMINA_JWT_SECRET=change-me-jwt-secret-at-least-32-chars-long

# ---------- 本地开发（不走 docker-compose、直接 IDE/命令行启动时）----------

# 本地 MySQL（application.yml 默认占位为 root/root123，按实际环境覆盖）
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=
# 本地 Redis（默认无密码）
SPRING_DATA_REDIS_PASSWORD=

# LLM（仅 Agent 服务，可选；不配置则走模拟模式）
# type: dashscope / openai / anthropic / ollama
# openai 类型兼容 DeepSeek/GLM/Moonshot 等（通过 base-url 适配）
LLM_TYPE=openai
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_STREAM=false

# RAG 知识库
# 是否启用 RAG
RAG_ENABLED=false
# 向量存储（memory=开发模式 / qdrant=生产）
RAG_STORE_TYPE=memory
# RAG 模式（generic=自动检索 / agentic=Agent 自主决定）
RAG_MODE=generic

# RAG Embedding（硅基流动 SiliconFlow 免费额度，OpenAI 兼容接口）
# 注册地址: https://cloud.siliconflow.cn
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
RAG_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
RAG_EMBEDDING_DIMENSIONS=1024

# Qdrant 向量数据库（RAG_STORE_TYPE=qdrant 时需要）
QDRANT_HOST=localhost:6334
QDRANT_COLLECTION=lumina_knowledge

# ---------- 监控（Prometheus + Grafana）----------
GRAFANA_PASSWORD=admin

# ---------- 分布式追踪（OpenTelemetry → Jaeger）----------
# 采样率（1.0=全采样，生产建议 0.1）
OTEL_SAMPLING_PROBABILITY=1.0
# OTLP 上报地址（Jaeger :4318）
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ---------- JVM ----------
GATEWAY_JAVA_OPTS=-Xms512m -Xmx512m
BUSINESS_BASE_JAVA_OPTS=-Xms512m -Xmx512m
AGENT_SERVICE_JAVA_OPTS=-Xms512m -Xmx512m

# ---------- RocketMQ 消息队列 ----------
# NameServer 地址（docker-compose 启动后默认 localhost:9876）
ROCKETMQ_NAME_SERVER=localhost:9876
# 知识库异步处理开关（false 时降级为同步处理）
MQ_KNOWLEDGE_ASYNC=true
